AWS_PROFILE="personal-devops"
AWS_REGION="eu-west-3"

NAMESPACE="argocd"
RELEASE_NAME="argocd"

HELM_REPOSITORY_NAME="argo"
HELM_REPOSITORY_URL="https://argoproj.github.io/argo-helm"

CHART_NAME="argo/argo-cd"
CHART_VERSION="10.3.0"

ARGOCD_HOSTNAME="argocd.ferdeve.fit"
SERVER_SERVICE="argocd-server"
TLS_SECRET_NAME="argocd-server-tls"
INGRESS_CLASS_NAME="nginx"
CLUSTER_ISSUER_NAME="letsencrypt-production"

EXPECTED_SERVER_REPLICAS="1"
EXPECTED_CONTROLLER_REPLICAS="1"
EXPECTED_REPO_SERVER_REPLICAS="1"
EXPECTED_APPLICATIONSET_REPLICAS="1"